{
  "name": "contanuevas",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "BOLETIN",
      "id": "708e9711a2c3401eb42fd6ca2fb31c78"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AVISOS", "class_name": "AvisosDiarios" }]
  },
  "migrations": [
    { "tag": "avisos-v1", "new_sqlite_classes": ["AvisosDiarios"] }
  ],
  "ratelimits": [
    { "name": "LIMITE_AVISOS", "namespace_id": "41111", "simple": { "limit": 8, "period": 60 } }
  ],
  "triggers": {
    "crons": [
      "17 9-23 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
