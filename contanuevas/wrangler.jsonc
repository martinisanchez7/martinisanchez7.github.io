{
  "name": "contanuevas",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "BOLETIN" }],
  "triggers": { "crons": ["17 9-23 * * *"] }
}
