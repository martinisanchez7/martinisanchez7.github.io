{
  "openapi": "3.1.0",
  "info": {
    "title": "Contanuevas",
    "version": "0.6.0",
    "description": "Boletín con alertas pendientes de cotejo y resúmenes normativos revisados. El respaldo de la fuente y la prioridad temática se informan por separado."
  },
  "servers": [
    {
      "url": "https://contanuevas.martinisanchez7.workers.dev"
    },
    {
      "url": "http://127.0.0.1:4195"
    }
  ],
  "paths": {
    "/api/v1/novedades": {
      "get": {
        "summary": "Consultar el boletín",
        "parameters": [
          {
            "name": "categoria",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "impositivo",
                "contable",
                "laboral",
                "internacional",
                "economia"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "modo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "archivo",
                "automatico",
                "editorial",
                "sintesis",
                "resumen"
              ]
            }
          },
          {
            "name": "desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "desde_fila",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999,
              "default": 0
            }
          },
          {
            "name": "respaldo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "oficial",
                "tecnico",
                "periodistico",
                "sin-clasificar"
              ]
            }
          },
          {
            "name": "importancia",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "alta",
                "seguimiento"
              ]
            }
          },
          {
            "name": "fuente",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ID del catálogo de fuentes"
          },
          {
            "name": "jurisdiccion",
            "in": "query",
            "description": "Alcance de la ficha. provincial reúne las provincias. CABA y Convenio Multilateral tienen sus propios filtros.",
            "schema": {
              "type": "string",
              "enum": [
                "provincial",
                "nacional",
                "caba",
                "interjurisdiccional",
                "internacional",
                "buenos-aires",
                "catamarca",
                "chaco",
                "chubut",
                "cordoba",
                "corrientes",
                "entre-rios",
                "formosa",
                "jujuy",
                "la-pampa",
                "la-rioja",
                "mendoza",
                "misiones",
                "neuquen",
                "rio-negro",
                "salta",
                "san-juan",
                "san-luis",
                "santa-cruz",
                "santa-fe",
                "santiago-del-estero",
                "tierra-del-fuego",
                "tucuman",
                "sin-clasificar"
              ]
            }
          },
          {
            "name": "orden",
            "in": "query",
            "description": "Orden por fecha, prioridad temática o perfil. El valor perfil requiere indicar también el parámetro perfil. La prioridad se desempata por fecha.",
            "schema": {
              "type": "string",
              "enum": [
                "recientes",
                "relevantes",
                "perfil"
              ],
              "default": "recientes"
            }
          },
          {
            "name": "perfil",
            "in": "query",
            "description": "Filtra por sector profesional. Otros conserva todas las fichas que coinciden con los demás filtros.",
            "schema": {
              "type": "string",
              "enum": [
                "impuestos",
                "payroll",
                "contabilidad",
                "auditoria",
                "finanzas",
                "precios-transferencia",
                "otros"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados paginados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "total",
                    "limite",
                    "desde_fila"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ficha"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "limite": {
                      "type": "integer"
                    },
                    "desde_fila": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Las respuestas públicas exitosas pueden reutilizarse durante 15 segundos.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Filtros inválidos"
          }
        }
      }
    },
    "/api/v1/novedades/{id}": {
      "get": {
        "summary": "Consultar una ficha",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ficha",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ficha"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Las respuestas públicas exitosas pueden reutilizarse durante 15 segundos.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Ficha no encontrada"
          }
        }
      }
    },
    "/api/v1/fuentes": {
      "get": {
        "summary": "Catálogo de fuentes",
        "responses": {
          "200": {
            "description": "Objetos con name, url y role en items",
            "headers": {
              "Cache-Control": {
                "description": "Las respuestas públicas exitosas pueden reutilizarse durante 15 segundos.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/actualizacion": {
      "get": {
        "summary": "Estado operativo de la importación",
        "responses": {
          "200": {
            "description": "Importación al día"
          },
          "503": {
            "description": "Importación pendiente, degradada o atrasada, o modo archivo"
          }
        }
      }
    },
    "/api/v1/salud": {
      "get": {
        "summary": "Estado de la última actualización",
        "responses": {
          "200": {
            "description": "Modo, intento de consulta, estado de fuentes, total de entradas y estado opcional de la copia local (sin-copia, guardada, restaurada o no-disponible)"
          }
        }
      }
    },
    "/api/v1/cotizaciones/usd-cierre": {
      "get": {
        "summary": "Último cierre minorista USD del BCRA",
        "description": "Pesos argentinos por dólar. La fecha pertenece a la observación oficial. Anterior contiene la observación precedente de la serie.",
        "responses": {
          "200": {
            "description": "Cotización de cierre",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "fecha",
                    "comprador",
                    "vendedor",
                    "anterior",
                    "fuente",
                    "url",
                    "rezagado"
                  ],
                  "properties": {
                    "fecha": {
                      "type": "string",
                      "format": "date"
                    },
                    "comprador": {
                      "type": "number"
                    },
                    "vendedor": {
                      "type": "number"
                    },
                    "anterior": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "fuente": {
                      "const": "BCRA"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "rezagado": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Consulta inválida"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ficha": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "category",
          "date",
          "source",
          "url",
          "mode",
          "jurisdictions",
          "profiles"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "impositivo",
              "contable",
              "laboral",
              "internacional",
              "economia"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "datePrecision": {
            "type": "string",
            "enum": [
              "month"
            ]
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "mode": {
            "type": "string",
            "enum": [
              "archivo",
              "automatico",
              "editorial",
              "sintesis"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceTier": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "type": [
              "string",
              "null"
            ]
          },
          "importance": {
            "type": [
              "string",
              "null"
            ]
          },
          "importanceReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "importanceMethod": {
            "type": [
              "string",
              "null"
            ]
          },
          "brief": {
            "type": "object",
            "description": "Resumen revisado: qué cambió, a quién alcanza, desde cuándo y qué hacer.",
            "required": [
              "whatChanged",
              "who",
              "when",
              "action",
              "limits",
              "scope"
            ],
            "properties": {
              "whatChanged": {
                "type": "string"
              },
              "who": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "limits": {
                "type": "string"
              },
              "reviewedAt": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "checkedAt": {
                "type": "string",
                "format": "date",
                "description": "Fecha de extracción automática del texto oficial."
              }
            }
          },
          "tables": {
            "type": "array",
            "description": "Cuadros cotejados con el texto o anexo original. Cada fila sigue el orden de las columnas.",
            "items": {
              "type": "object",
              "required": [
                "caption",
                "columns",
                "rows"
              ],
              "properties": {
                "caption": {
                  "type": "string"
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "period": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}$",
                  "description": "Período de la escala en formato AAAA-MM cuando el cuadro se puede usar en el simulador."
                }
              }
            }
          },
          "reviewedId": {
            "type": "string",
            "description": "ID de la ficha editorial vinculada a esta alerta."
          },
          "alertUrls": {
            "type": "array",
            "description": "Enlaces de alertas vinculadas a este resumen.",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "summaryId": {
            "type": "string",
            "description": "ID de la síntesis automática vinculada al aviso oficial."
          },
          "jurisdictions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "nacional",
                "caba",
                "interjurisdiccional",
                "internacional",
                "buenos-aires",
                "catamarca",
                "chaco",
                "chubut",
                "cordoba",
                "corrientes",
                "entre-rios",
                "formosa",
                "jujuy",
                "la-pampa",
                "la-rioja",
                "mendoza",
                "misiones",
                "neuquen",
                "rio-negro",
                "salta",
                "san-juan",
                "san-luis",
                "santa-cruz",
                "santa-fe",
                "santiago-del-estero",
                "tierra-del-fuego",
                "tucuman",
                "sin-clasificar"
              ]
            }
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "impuestos",
                "payroll",
                "contabilidad",
                "auditoria",
                "finanzas",
                "precios-transferencia"
              ]
            }
          }
        }
      }
    }
  }
}
