{
  "openapi": "3.1.0",
  "info": {
    "title": "Contanuevas",
    "version": "0.2.0",
    "description": "Boletín con alertas pendientes de cotejo y resúmenes normativos revisados. El respaldo de la fuente y la prioridad temática se informan por separado."
  },
  "servers": [
    {
      "url": "https://contanuevas.martinisanchez7.workers.dev"
    },
    {
      "url": "http://127.0.0.1:4195"
    }
  ],
  "paths": {
    "/api/v1/novedades": {
      "get": {
        "summary": "Consultar el boletín",
        "parameters": [
          {
            "name": "categoria",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "impositivo",
                "contable",
                "laboral",
                "internacional",
                "economia"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "modo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "archivo",
                "automatico",
                "editorial"
              ]
            }
          },
          {
            "name": "desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "desde_fila",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999,
              "default": 0
            }
          },
          {
            "name": "respaldo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "oficial",
                "tecnico",
                "periodistico",
                "sin-clasificar"
              ]
            }
          },
          {
            "name": "importancia",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "alta",
                "seguimiento"
              ]
            }
          },
          {
            "name": "fuente",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ID del catálogo de fuentes"
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados paginados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "total",
                    "limite",
                    "desde_fila"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ficha"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "limite": {
                      "type": "integer"
                    },
                    "desde_fila": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Filtros inválidos"
          }
        }
      }
    },
    "/api/v1/novedades/{id}": {
      "get": {
        "summary": "Consultar una ficha",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ficha",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ficha"
                }
              }
            }
          },
          "404": {
            "description": "Ficha no encontrada"
          }
        }
      }
    },
    "/api/v1/fuentes": {
      "get": {
        "summary": "Catálogo de fuentes",
        "responses": {
          "200": {
            "description": "Objetos con name, url y role en items"
          }
        }
      }
    },
    "/api/v1/actualizacion": {
      "get": {
        "summary": "Estado operativo de la importación",
        "responses": {
          "200": {
            "description": "Importación al día"
          },
          "503": {
            "description": "Importación pendiente, degradada o atrasada, o modo archivo"
          }
        }
      }
    },
    "/api/v1/salud": {
      "get": {
        "summary": "Estado de la última actualización",
        "responses": {
          "200": {
            "description": "Modo, intento de consulta, estado de fuentes, total de entradas y estado opcional de la copia local (sin-copia, guardada, restaurada o no-disponible)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ficha": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "category",
          "date",
          "source",
          "url",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "impositivo",
              "contable",
              "laboral",
              "internacional",
              "economia"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "datePrecision": {
            "type": "string",
            "enum": [
              "month"
            ]
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "mode": {
            "type": "string",
            "enum": [
              "archivo",
              "automatico",
              "editorial"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceTier": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "type": [
              "string",
              "null"
            ]
          },
          "importance": {
            "type": [
              "string",
              "null"
            ]
          },
          "importanceReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "importanceMethod": {
            "type": [
              "string",
              "null"
            ]
          },
          "brief": {
            "type": "object",
            "description": "Resumen revisado: qué cambió, a quién alcanza, desde cuándo y qué hacer.",
            "required": [
              "whatChanged",
              "who",
              "when",
              "action",
              "limits",
              "reviewedAt",
              "scope"
            ],
            "properties": {
              "whatChanged": {
                "type": "string"
              },
              "who": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "limits": {
                "type": "string"
              },
              "reviewedAt": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}